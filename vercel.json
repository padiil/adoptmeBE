{
  "version": 2,
  "builds": [
    {
      "src": "app.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "docs/**"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/api-docs/openapi.yml",
      "dest": "/docs/openapi.yml"
    },
    {
      "src": "/(.*)",
      "dest": "app.js"
    }
  ]
}
